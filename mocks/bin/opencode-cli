#!/usr/bin/env bash
# Alias wrapper for the internal BYOK OpenCode runtime and public OpenCode
# fallback. Both use the same deterministic protocol implementation.
# Delegates to the same mock as mocks/bin/opencode.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
exec node "$HERE/../mock-agent.mjs" --as opencode "$@"
